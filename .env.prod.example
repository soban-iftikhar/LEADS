# Copy to .env.prod on the server and fill in. Never commit .env.prod.

# --- Database (also used to build DATABASE_URL inside the containers)
POSTGRES_USER=leads
POSTGRES_PASSWORD=CHANGE_ME_LONG_RANDOM
POSTGRES_DB=leads
POSTGRES_HOST_PORT=5432

# --- Daily crawl time, Asia/Karachi
DAILY_SCRAPE_HOUR=2
DAILY_SCRAPE_MINUTE=0
CRAWL_WINDOW_HOURS=26
DAILY_MAX_PAGES=15

# --- Phone protection: base64 of 32 random bytes each:  head -c 32 /dev/urandom | base64
# Back these up separately from the database. Losing PHONE_ENC_KEY makes stored phones unreadable.
PHONE_HASH_PEPPER=
PHONE_ENC_KEY=
PHONE_PURGE_DAYS=60

# --- Crawling manners: one fixed identity, robots.txt respected
# SCRAPER_USER_AGENT=
ROBOTSTXT_OBEY=true

# --- Portal logins, copied from a logged-in browser session
OLX_ACCESS_TOKEN=
OLX_ID_TOKEN=
OLX_REFRESH_TOKEN=
ILAAN_AUTH_TOKEN=
ILAAN_CSRF_TOKEN=

# --- Failure alerts by email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=

# --- Web app only (profile "web")
WEB_PORT=3000
JWT_SECRET=
NEXT_PUBLIC_APP_URL=https://your-domain
# Number of reverse proxies in front of the web container (Caddy/nginx = 1)
TRUSTED_PROXY_HOPS=1
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
GEMINI_API_KEY=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
# Required: webhook calls without a valid Meta signature are rejected in production
WHATSAPP_APP_SECRET=
