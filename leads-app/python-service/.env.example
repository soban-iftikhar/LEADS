# Copy to .env (or .env.local for personal overrides) and fill in. Never commit either.
# Every value is validated at startup by leads/settings.py, the only place that reads them.

# --- Database and broker
DATABASE_URL=postgresql://leads_user:CHANGE_ME@localhost:5432/leads_db
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TIMEZONE=Asia/Karachi

# --- Phone protection: base64 of 32 random bytes each (head -c 32 /dev/urandom | base64).
# The web app must use the same two values. Back them up apart from the database.
PHONE_HASH_PEPPER=
PHONE_ENC_KEY=
PHONE_PURGE_DAYS=60

# --- Portal logins, copied from a logged-in browser session (never hardcode)
OLX_ACCESS_TOKEN=
OLX_ID_TOKEN=
OLX_REFRESH_TOKEN=
# ILAAN_AUTH_TOKEN = value of the `auth_token` cookie, ILAAN_CSRF_TOKEN = X-CSRF-Token request header
ILAAN_AUTH_TOKEN=
ILAAN_CSRF_TOKEN=

# --- Daily crawl (Asia/Karachi). 26 h window so listings at the edge of "1 day ago" are kept.
DAILY_SCRAPE_HOUR=2
DAILY_SCRAPE_MINUTE=0
CRAWL_WINDOW_HOURS=26
DAILY_MAX_PAGES=15
# CRAWL_LOG_DIR=./logs

# --- Crawling manners. One fixed identity; robots.txt respected unless you set this false.
# SCRAPER_USER_AGENT=
ROBOTSTXT_OBEY=true

# --- Area conversion (Islamabad/Rawalpindi convention)
MARLA_SQFT=225
KANAL_MARLA=20

# --- Failure alerts by email (Resend)
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=
