OLX_ACCESS_TOKEN=
OLX_ID_TOKEN=
OLX_REFRESH_TOKEN=

POSTGRES_DSN=postgresql://leads_user:leads_password@
# Ilaan login, copied from a logged-in browser session (never hardcode):
# ILAAN_AUTH_TOKEN = value of the `auth_token` cookie, ILAAN_CSRF_TOKEN = X-CSRF-Token request header
ILAAN_AUTH_TOKEN=
ILAAN_CSRF_TOKEN=

# Database and broker
DATABASE_URL=postgresql://leads_user:CHANGE_ME@localhost:5432/leads_db
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/1
CELERY_TIMEZONE=Asia/Karachi

# Phone protection: base64 of 32 random bytes each (head -c 32 /dev/urandom | base64).
# The web app must use the same two values.
PHONE_HASH_PEPPER=
PHONE_ENC_KEY=
PHONE_PURGE_DAYS=60

# Area conversion (Islamabad/Rawalpindi convention)
MARLA_SQFT=225
KANAL_MARLA=20

# Alerts
RESEND_API_KEY=
EMAIL_FROM=
ADMIN_ALERT_EMAIL=
