# Copy to .env and fill in. Never commit .env. Every value is validated at first use
# by src/server/env.ts, which is the only place that reads process.env.

# --- Database and cache
DATABASE_URL="postgresql://leads_user:leads_password@localhost:5432/leads_db"
REDIS_URL="redis://localhost:6379/2"

# --- Auth: signs the 15-minute access token (httpOnly cookie). 32+ random characters:
# openssl rand -base64 48. The refresh token is opaque and stored hashed in app.sessions.
JWT_SECRET=""
# Encrypts admin two-factor (TOTP) secrets. Base64 of 32 random bytes: openssl rand -base64 32
TOTP_ENC_KEY=""

# --- Rate limiting: how many reverse proxies (nginx, Caddy, load balancer) sit in front
# of the app. The client address is read from the X-Forwarded-For entry they wrote.
TRUSTED_PROXY_HOPS=1

# --- Public URL, used in email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- One-time codes (email and WhatsApp). OTP_PEPPER: base64 of 32 random bytes
# (openssl rand -base64 32). Codes are stored only as HMAC(OTP_PEPPER, user:code).
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_PEPPER=""

# live = send codes by email/WhatsApp; log = only print them in the server log (local tests).
AUTH_DELIVERY="live"

# --- Google sign-in (Google Cloud console > APIs & Services > Credentials > OAuth client ID,
# type "Web application"). Authorised redirect URI: ${NEXT_PUBLIC_APP_URL}/api/auth/google/callback
# Leave empty to hide the Google button.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# --- Phone protection: the SAME two values as python-service/.env (base64, 32 bytes each).
# Needed to match WhatsApp replies to contacts.
PHONE_HASH_PEPPER=""
PHONE_ENC_KEY=""

# --- Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM_NAME="LEADS"
EMAIL_FROM=""

# --- Payments: "manual" (bank transfer, confirmed by an admin) or "sandbox" (local development
# only: card and wallet payments confirm at once). Bank details live in config.app_settings
# under "payments.bank_transfer" ({ bank, accountTitle, iban }).
PAYMENT_PROVIDER="manual"

# --- Photos and ownership documents (Cloudinary). Empty in development = files are kept on
# disk under public/uploads and .data/; production refuses uploads without Cloudinary.
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AI (Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# --- WhatsApp Cloud API. Leave TOKEN empty to run in mock mode (nothing is sent).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"
# Approved AUTHENTICATION template for login codes (one body parameter = the code, plus the
# copy-code button). Without it codes are sent as plain text, which WhatsApp only delivers
# inside a 24-hour customer window.
WHATSAPP_OTP_TEMPLATE=""
WHATSAPP_OTP_TEMPLATE_LANG="en"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Required in production: webhook calls without a valid Meta signature are rejected.
WHATSAPP_APP_SECRET=""
