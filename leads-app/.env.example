# Database
DATABASE_URL="postgresql://user:password@localhost:5432/leads_db"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="your-super-secret-jwt-key"
JWT_EXPIRES_IN="7d"

# SendGrid
SENDGRID_API_KEY=""
SENDGRID_FROM_EMAIL=""

# Cloudinary
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Google Gemini
GEMINI_API_KEY=""

# OpenAI
OPENAI_API_KEY=""

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_SOCKET_URL="http://localhost:3001"
PYTHON_SERVICE_URL="http://localhost:5001"

# OTP
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=3

# WhatsApp Cloud API
WHATSAPP_TOKEN=<your permanent token, once the System User step is done>
WHATSAPP_PHONE_NUMBER_ID=<from the dashboard>
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=<any string you make up yourself — used in step 6 below too>