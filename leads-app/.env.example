# Copy to .env and fill in. Never commit .env. Every value is validated at first use
# by src/server/env.ts, which is the only place that reads process.env.

# --- Database and cache
DATABASE_URL="postgresql://leads_user:leads_password@localhost:5432/leads_db"
REDIS_URL="redis://localhost:6379/2"

# --- Sessions: at least 32 random characters (openssl rand -base64 48)
JWT_SECRET=""
JWT_EXPIRES_IN="7d"

# --- Rate limiting: how many reverse proxies (nginx, Caddy, load balancer) sit in front
# of the app. The client address is read from the X-Forwarded-For entry they wrote.
TRUSTED_PROXY_HOPS=1

# --- Public URL, used in email links
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- One-time codes
OTP_EXPIRY_MINUTES=10
OTP_MAX_ATTEMPTS=5

# --- Phone protection: the SAME two values as python-service/.env (base64, 32 bytes each).
# Needed to match WhatsApp replies to contacts.
PHONE_HASH_PEPPER=""
PHONE_ENC_KEY=""

# --- Email (Resend)
RESEND_API_KEY=""
EMAIL_FROM_NAME="LEADS"
EMAIL_FROM=""

# --- Images (Cloudinary)
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# --- AI (Gemini)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-latest"

# --- WhatsApp Cloud API. Leave TOKEN empty to run in mock mode (nothing is sent).
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_API_VERSION="v20.0"
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""
# Required in production: webhook calls without a valid Meta signature are rejected.
WHATSAPP_APP_SECRET=""
