}

model LegacyUser {
  id                     String          @id @default(cuid())
  fullName               String
  email                  String          @unique
  phone                  String?         @unique
  passwordHash           String
  role                   LegacyRole
  passwordResetToken     String?
  passwordResetExpiresAt DateTime?
  isEmailVerified        Boolean         @default(false)
  isPhoneVerified        Boolean         @default(false)
  emailOtpHash           String?
  emailOtpExpiresAt      DateTime?
  phoneOtpHash           String?
  phoneOtpExpiresAt      DateTime?
  otpAttempts            Int             @default(0)
  isActive               Boolean         @default(true)
  createdAt              DateTime        @default(now())
  updatedAt              DateTime        @updatedAt
  listings               LegacyListing[]

  @@map("users")
  @@schema("public")
}

model LegacyListing {
  id             String              @id @default(cuid())
  title          String
  category       String
  purpose        LegacyPurpose
  city           String
  locality       String
  size           Float
  sizeUnit       LegacySizeUnit
  price          Float
  bedrooms       Int?
  bathrooms      Int?
  description    String
  images         String[]
  status         LegacyListingStatus @default(PENDING_AI_REVIEW)
  originalDesc   String?
  aiEnhancedDesc String?
  sellerId       String
  seller         LegacyUser          @relation(fields: [sellerId], references: [id])
  viewCount      Int                 @default(0)
  createdAt      DateTime            @default(now())
  updatedAt      DateTime            @updatedAt

  @@index([city, category, purpose])
  @@map("listings")
  @@schema("public")
}

model Property {
  id               String           @id @default(cuid())
  platform         String
  listingId        String
  url              String
  title            String
  category         String
  purpose          LegacyPurpose?
  price            String
  priceNumeric     Float
  size             String
  sizeNumeric      Float
  sizeUnit         LegacySizeUnit
  city             String
  location         String
  locality         String
  bedrooms         Int              @default(0)
  bathrooms        Int              @default(0)
  description      String
  amenities        String[]
  sellerName       String?
  agencyName       String?
  phone            String?
  mobile           String?
  agencyProfileUrl String?
  addedDate        String?
  listedAt         DateTime?
  isProject        Boolean          @default(false)
  scrapedAt        DateTime         @default(now())
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  prospects        LegacyProspect[]

  @@unique([platform, listingId])
  @@index([city, category, purpose])
  @@index([priceNumeric])
  @@index([scrapedAt])
  @@map("properties")
  @@schema("public")
}

model LegacyProspect {
  id            String               @id @default(cuid())
  propertyId    String
  property      Property             @relation(fields: [propertyId], references: [id])
  contact       String
  waMessageId   String?
  status        LegacyProspectStatus @default(CONTACTED)
  contactedAt   DateTime             @default(now())
  repliedAt     DateTime?
  lastReplyText String?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt

  @@map("prospects")
  @@schema("public")
}
