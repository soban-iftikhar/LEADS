// LEADS database. One Postgres instance, one schema per concern (DR-17, DR-23).
// Python reads and writes the same tables with plain SQL, so every id and
// timestamp default is set in the database, not by the Prisma client.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  schemas  = ["public", "config", "app", "intel", "ops", "master", "zameen", "olx", "graana", "ilaan"]
}

// =============================================================================
// config
// =============================================================================

model Region {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name       String            @unique
  slug       String            @unique
  active     Boolean           @default(false)
  createdAt  DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  localities Locality[]
  portalMaps PortalRegionMap[]
  segments   CrawlSegment[]

  @@map("regions")
  @@schema("config")
}

model Locality {
  id       String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  regionId String     @map("region_id") @db.Uuid
  name     String
  slug     String
  aliases  String[]
  parentId String?    @map("parent_id") @db.Uuid
  lat      Decimal?   @db.Decimal(9, 6)
  lng      Decimal?   @db.Decimal(9, 6)
  active   Boolean    @default(true)
  region   Region     @relation(fields: [regionId], references: [id])
  parent   Locality?  @relation("LocalityTree", fields: [parentId], references: [id])
  children Locality[] @relation("LocalityTree")

  @@unique([regionId, slug])
  @@map("localities")
  @@schema("config")
}

model Portal {
  id                String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  slug              String            @unique // zameen | olx | graana | ilaan
  name              String
  active            Boolean           @default(true)
  requestsPerMinute Int               @default(20) @map("requests_per_minute")
  regionMaps        PortalRegionMap[]
  segments          CrawlSegment[]

  @@map("portals")
  @@schema("config")
}

model PortalRegionMap {
  id             String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portalId       String  @map("portal_id") @db.Uuid
  regionId       String  @map("region_id") @db.Uuid
  externalCityId String  @map("external_city_id")
  active         Boolean @default(true)
  portal         Portal  @relation(fields: [portalId], references: [id])
  region         Region  @relation(fields: [regionId], references: [id])

  @@unique([portalId, regionId])
  @@map("portal_region_maps")
  @@schema("config")
}

model CrawlSegment {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  portalId  String    @map("portal_id") @db.Uuid
  regionId  String    @map("region_id") @db.Uuid
  category  String
  purpose   String
  active    Boolean   @default(true)
  lastRunAt DateTime? @map("last_run_at") @db.Timestamptz(6)
  portal    Portal    @relation(fields: [portalId], references: [id])
  region    Region    @relation(fields: [regionId], references: [id])

  @@unique([portalId, regionId, category, purpose])
  @@map("crawl_segments")
  @@schema("config")
}

model LeadCriteria {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version     Int      @unique
  rules       Json     @db.JsonB // format: SPEC_00 3.7
  active      Boolean  @default(false)
  createdById String   @map("created_by_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("lead_criteria")
  @@schema("config")
}

model PackagePlan {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  leadCount    Int     @map("lead_count")
  pricePkr     BigInt  @map("price_pkr")
  deliveryDays Int     @default(60) @map("delivery_days")
  active       Boolean @default(true)
  sortOrder    Int     @default(0) @map("sort_order")
  orders       Order[]

  @@map("package_plans")
  @@schema("config")
}

model MessageTemplate {
  id             String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  key            String           @unique
  purpose        TemplatePurpose
  language       TemplateLanguage
  body           String // {{placeholders}}
  waTemplateName String?          @map("wa_template_name") // approved Cloud API template name
  active         Boolean          @default(true)

  @@map("message_templates")
  @@schema("config")
}

model AppSetting {
  key         String   @id
  value       Json     @db.JsonB
  updatedById String?  @map("updated_by_id") @db.Uuid
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)

  @@map("app_settings")
  @@schema("config")
}

enum TemplatePurpose {
  PROSPECT_SELLER
  BUYER_CAMPAIGN
  FOLLOW_UP
  FORM_LINK
  LEAD_DELIVERED

  @@schema("config")
}

enum TemplateLanguage {
  EN
  ROMAN_UR

  @@schema("config")
}

// =============================================================================
// app: identity
// =============================================================================

model User {
  id               String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email            String              @unique // stored lowercased
  passwordHash     String              @map("password_hash") // bcrypt cost 12
  role             Role
  status           UserStatus          @default(ACTIVE)
  emailVerifiedAt  DateTime?           @map("email_verified_at") @db.Timestamptz(6)
  phoneHash        String?             @unique @map("phone_hash")
  phoneEnc         String?             @map("phone_enc")
  phoneVerifiedAt  DateTime?           @map("phone_verified_at") @db.Timestamptz(6)
  failedLoginCount Int                 @default(0) @map("failed_login_count")
  lockedUntil      DateTime?           @map("locked_until") @db.Timestamptz(6)
  lastLoginAt      DateTime?           @map("last_login_at") @db.Timestamptz(6)
  createdAt        DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime            @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer         CustomerProfile?
  buyer            BuyerProfile?
  sessions         Session[]
  tokens           VerificationToken[]
  listings         Listing[]
  savedListings    SavedListing[]
  orders           Order[]
  leads            Lead[]
  notifications    Notification[]

  @@map("users")
  @@schema("app")
}

enum Role {
  CUSTOMER_SELLER
  CUSTOMER_AGENCY
  BUYER
  ADMIN

  @@schema("app")
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED

  @@schema("app")
}

model Session {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent String?   @map("user_agent")
  ipHash    String?   @map("ip_hash")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
  @@schema("app")
}

model VerificationToken {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  type      TokenType
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(6)
  usedAt    DateTime? @map("used_at") @db.Timestamptz(6)
  attempts  Int       @default(0)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, type])
  @@map("verification_tokens")
  @@schema("app")
}

enum TokenType {
  EMAIL_VERIFY
  PASSWORD_RESET
  PHONE_OTP

  @@schema("app")
}

model CustomerProfile {
  userId        String       @id @map("user_id") @db.Uuid
  kind          CustomerKind
  displayName   String       @map("display_name") // person or agency name
  contactPerson String?      @map("contact_person") // agency only
  areas         String[] // locality ids
  propertyTypes String[]     @map("property_types")
  createdAt     DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("customer_profiles")
  @@schema("app")
}

enum CustomerKind {
  SELLER
  AGENCY

  @@schema("app")
}

model BuyerProfile {
  userId         String   @id @map("user_id") @db.Uuid
  name           String
  contactId      String?  @unique @map("contact_id") @db.Uuid
  preferredAreas String[] @map("preferred_areas")
  budgetMinPkr   BigInt?  @map("budget_min_pkr")
  budgetMaxPkr   BigInt?  @map("budget_max_pkr")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  contact        Contact? @relation(fields: [contactId], references: [id])

  @@map("buyer_profiles")
  @@schema("app")
}

// =============================================================================
// app: listings on LEADS (verified)
// =============================================================================

model Listing {
  id              String          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String          @map("customer_id") @db.Uuid
  source          ListingSource
  masterListingId String?         @map("master_listing_id") @db.Uuid
  slug            String          @unique
  title           String
  description     String?
  category        String
  purpose         String
  pricePkr        BigInt          @map("price_pkr")
  sizeValue       Decimal         @map("size_value") @db.Decimal(12, 2)
  sizeUnit        String          @map("size_unit")
  sizeSqft        Decimal         @map("size_sqft") @db.Decimal(12, 2)
  regionId        String          @map("region_id") @db.Uuid
  localityId      String          @map("locality_id") @db.Uuid
  addressText     String?         @map("address_text")
  lat             Decimal?        @db.Decimal(9, 6)
  lng             Decimal?        @db.Decimal(9, 6)
  bedrooms        Int?
  bathrooms       Int?
  amenities       String[]
  status          ListingStatus   @default(DRAFT)
  criteriaVersion Int?            @map("criteria_version")
  criteriaResult  Json?           @map("criteria_result") @db.JsonB
  rejectionReason String?         @map("rejection_reason")
  publishedAt     DateTime?       @map("published_at") @db.Timestamptz(6)
  soldAt          DateTime?       @map("sold_at") @db.Timestamptz(6)
  createdAt       DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime        @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        User            @relation(fields: [customerId], references: [id])
  masterListing   MasterListing?  @relation(fields: [masterListingId], references: [id])
  images          ListingImage[]
  reviews         ListingReview[]
  savedBy         SavedListing[]
  orders          Order[]
  campaigns       Campaign[]
  leads           Lead[]

  @@index([status, regionId, localityId, category, purpose])
  @@index([customerId])
  @@map("listings")
  @@schema("app")
}

enum ListingSource {
  SELF_POSTED
  AGENCY_POSTED
  PROSPECT_CONVERTED

  @@schema("app")
}

enum ListingStatus {
  DRAFT
  UNDER_REVIEW
  NEEDS_INFO
  APPROVED
  REJECTED
  PAUSED
  SOLD
  ARCHIVED

  @@schema("app")
}

model ListingImage {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId    String  @map("listing_id") @db.Uuid
  cloudinaryId String  @map("cloudinary_id")
  url          String
  position     Int
  listing      Listing @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@unique([listingId, position])
  @@map("listing_images")
  @@schema("app")
}

model ListingReview {
  id        String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  listingId String         @map("listing_id") @db.Uuid
  adminId   String         @map("admin_id") @db.Uuid
  decision  ReviewDecision
  note      String?
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  listing   Listing        @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@index([listingId])
  @@map("listing_reviews")
  @@schema("app")
}

enum ReviewDecision {
  APPROVE
  REJECT
  NEED_INFO

  @@schema("app")
}

model SavedListing {
  buyerUserId String   @map("buyer_user_id") @db.Uuid
  listingId   String   @map("listing_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  buyer       User     @relation(fields: [buyerUserId], references: [id], onDelete: Cascade)
  listing     Listing  @relation(fields: [listingId], references: [id], onDelete: Cascade)

  @@id([buyerUserId, listingId])
  @@map("saved_listings")
  @@schema("app")
}

// =============================================================================
// app: packages, money
// =============================================================================

model Order {
  id              String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  customerId      String      @map("customer_id") @db.Uuid
  listingId       String      @map("listing_id") @db.Uuid
  packagePlanId   String      @map("package_plan_id") @db.Uuid
  leadCount       Int         @map("lead_count") // snapshot at purchase
  pricePkr        BigInt      @map("price_pkr") // snapshot at purchase
  pricePerLeadPkr BigInt      @map("price_per_lead_pkr") // snapshot at purchase
  status          OrderStatus @default(PENDING_PAYMENT)
  windowStartsAt  DateTime?   @map("window_starts_at") @db.Timestamptz(6) // set on payment
  windowEndsAt    DateTime?   @map("window_ends_at") @db.Timestamptz(6)
  deliveredCount  Int         @default(0) @map("delivered_count")
  createdAt       DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime    @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer        User        @relation(fields: [customerId], references: [id])
  listing         Listing     @relation(fields: [listingId], references: [id])
  packagePlan     PackagePlan @relation(fields: [packagePlanId], references: [id])
  payments        Payment[]
  cashback        Cashback?
  campaign        Campaign?
  leads           Lead[]

  @@index([customerId])
  @@index([status, windowEndsAt])
  @@map("orders")
  @@schema("app")
}

enum OrderStatus {
  PENDING_PAYMENT
  ACTIVE
  COMPLETED
  EXPIRED
  CANCELLED

  @@schema("app")
}

model Payment {
  id          String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String        @map("order_id") @db.Uuid
  provider    String
  providerRef String?       @unique @map("provider_ref")
  amountPkr   BigInt        @map("amount_pkr")
  status      PaymentStatus
  raw         Json?         @db.JsonB
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  order       Order         @relation(fields: [orderId], references: [id])

  @@index([orderId])
  @@map("payments")
  @@schema("app")
}

enum PaymentStatus {
  PENDING
  SUCCEEDED
  FAILED
  REFUNDED

  @@schema("app")
}

model Cashback {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId          String         @unique @map("order_id") @db.Uuid
  undeliveredCount Int            @map("undelivered_count")
  amountPkr        BigInt         @map("amount_pkr")
  status           CashbackStatus @default(PENDING)
  providerRef      String?        @map("provider_ref")
  paidAt           DateTime?      @map("paid_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  order            Order          @relation(fields: [orderId], references: [id])

  @@map("cashbacks")
  @@schema("app")
}

enum CashbackStatus {
  PENDING
  PAID
  FAILED

  @@schema("app")
}

// =============================================================================
// app: people, outreach, leads
// =============================================================================

// One row per real phone number we know about: prospects, campaign targets, buyers (DR-25).
model Contact {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  phoneHash         String              @unique @map("phone_hash")
  phoneEnc          String?             @map("phone_enc") // cleared by the purge job
  name              String?
  firstSource       ContactSource       @map("first_source")
  dnc               Boolean             @default(false)
  dncReason         DncReason?          @map("dnc_reason")
  dncAt             DateTime?           @map("dnc_at") @db.Timestamptz(6)
  purgeAt           DateTime?           @map("purge_at") @db.Timestamptz(6) // null once the contact is a lead or user
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  buyerProfile      BuyerProfile?
  capCounters       ContactCapCounter[]
  prospectOutreach  ProspectOutreach[]
  campaignTargets   CampaignTarget[]
  messages          Message[]
  formLinks         FormLink[]
  leads             Lead[]
  sellerLinks       SellerContactLink[]

  @@index([purgeAt])
  @@map("contacts")
  @@schema("app")
}

enum ContactSource {
  PORTAL_SELLER
  BUYER_SIGNUP
  FORM
  INQUIRY

  @@schema("app")
}

enum DncReason {
  STOP_REQUEST
  ANGRY_REPLY
  ADMIN
  COMPLAINT

  @@schema("app")
}

model ContactCapCounter {
  contactId    String   @map("contact_id") @db.Uuid
  periodStart  DateTime @map("period_start") @db.Timestamptz(6)
  listingsSent Int      @default(0) @map("listings_sent")
  contact      Contact  @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@id([contactId, periodStart])
  @@map("contact_cap_counters")
  @@schema("app")
}

// Converting a portal seller into a customer (PRS-1).
model ProspectOutreach {
  id                 String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  masterListingId    String         @unique @map("master_listing_id") @db.Uuid
  contactId          String         @map("contact_id") @db.Uuid
  selectedById       String         @map("selected_by_id") @db.Uuid
  status             ProspectStatus @default(SELECTED)
  convertedUserId    String?        @map("converted_user_id") @db.Uuid
  convertedListingId String?        @map("converted_listing_id") @db.Uuid
  createdAt          DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  masterListing      MasterListing  @relation(fields: [masterListingId], references: [id])
  contact            Contact        @relation(fields: [contactId], references: [id])
  messages           Message[]
  formLinks          FormLink[]

  @@index([contactId])
  @@map("prospect_outreach")
  @@schema("app")
}

enum ProspectStatus {
  SELECTED
  CONTACTED
  REPLIED
  INTERESTED
  FORM_SENT
  CONVERTED
  DECLINED
  STOPPED
  NO_REPLY

  @@schema("app")
}

// Finding buyers for a paid order (SYS-2).
model Campaign {
  id          String           @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  orderId     String           @unique @map("order_id") @db.Uuid
  listingId   String           @map("listing_id") @db.Uuid
  status      CampaignStatus   @default(PLANNED)
  matchParams Json             @map("match_params") @db.JsonB
  startedAt   DateTime?        @map("started_at") @db.Timestamptz(6)
  endedAt     DateTime?        @map("ended_at") @db.Timestamptz(6)
  order       Order            @relation(fields: [orderId], references: [id])
  listing     Listing          @relation(fields: [listingId], references: [id])
  targets     CampaignTarget[]

  @@map("campaigns")
  @@schema("app")
}

enum CampaignStatus {
  PLANNED
  RUNNING
  PAUSED
  DONE

  @@schema("app")
}

model CampaignTarget {
  id                    String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  campaignId            String         @map("campaign_id") @db.Uuid
  contactId             String         @map("contact_id") @db.Uuid
  sourceMasterListingId String?        @map("source_master_listing_id") @db.Uuid
  score                 Decimal        @db.Decimal(8, 4)
  status                TargetStatus   @default(QUEUED)
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime       @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  campaign              Campaign       @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  contact               Contact        @relation(fields: [contactId], references: [id])
  sourceMasterListing   MasterListing? @relation(fields: [sourceMasterListingId], references: [id])
  messages              Message[]
  formLinks             FormLink[]

  @@unique([campaignId, contactId])
  @@index([status])
  @@map("campaign_targets")
  @@schema("app")
}

enum TargetStatus {
  QUEUED
  SKIPPED_DNC
  SKIPPED_CAP
  SENT
  REPLIED
  INTERESTED
  NOT_INTERESTED
  STOPPED
  FORM_SENT
  FORM_SUBMITTED
  CONVERTED
  NO_REPLY

  @@schema("app")
}

model Message {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  contactId          String            @map("contact_id") @db.Uuid
  direction          Direction
  channel            Channel
  campaignTargetId   String?           @map("campaign_target_id") @db.Uuid
  prospectOutreachId String?           @map("prospect_outreach_id") @db.Uuid
  templateId         String?           @map("template_id") @db.Uuid
  body               String
  waMessageId        String?           @unique @map("wa_message_id")
  status             MessageStatus
  sentByUserId       String?           @map("sent_by_user_id") @db.Uuid // staff who tapped send in WA_LINK mode
  intent             Intent?
  intentConfidence   Decimal?          @map("intent_confidence") @db.Decimal(4, 3)
  classifierModel    String?           @map("classifier_model")
  needsReview        Boolean           @default(false) @map("needs_review")
  createdAt          DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt             DateTime?         @map("sent_at") @db.Timestamptz(6)
  contact            Contact           @relation(fields: [contactId], references: [id])
  campaignTarget     CampaignTarget?   @relation(fields: [campaignTargetId], references: [id])
  prospectOutreach   ProspectOutreach? @relation(fields: [prospectOutreachId], references: [id])

  @@index([contactId, createdAt])
  @@map("messages")
  @@schema("app")
}

enum Direction {
  OUT
  IN

  @@schema("app")
}

enum Channel {
  WA_API
  WA_LINK

  @@schema("app")
}

enum MessageStatus {
  PENDING_STAFF
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED
  RECEIVED

  @@schema("app")
}

enum Intent {
  INTERESTED
  NOT_INTERESTED
  QUESTION
  STOP
  ANGRY
  OTHER

  @@schema("app")
}

model FormLink {
  id                 String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  tokenHash          String            @unique @map("token_hash") // the URL carries the raw token
  kind               FormKind
  contactId          String            @map("contact_id") @db.Uuid
  listingId          String?           @map("listing_id") @db.Uuid
  masterListingId    String?           @map("master_listing_id") @db.Uuid
  campaignTargetId   String?           @map("campaign_target_id") @db.Uuid
  prospectOutreachId String?           @map("prospect_outreach_id") @db.Uuid
  expiresAt          DateTime          @map("expires_at") @db.Timestamptz(6)
  openedAt           DateTime?         @map("opened_at") @db.Timestamptz(6)
  submittedAt        DateTime?         @map("submitted_at") @db.Timestamptz(6)
  contact            Contact           @relation(fields: [contactId], references: [id])
  campaignTarget     CampaignTarget?   @relation(fields: [campaignTargetId], references: [id])
  prospectOutreach   ProspectOutreach? @relation(fields: [prospectOutreachId], references: [id])
