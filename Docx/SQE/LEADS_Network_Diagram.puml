@startuml
skinparam defaultFontName "Helvetica"
skinparam defaultFontSize 9
skinparam defaultTextAlignment center
skinparam roundCorner 8
skinparam shadowing false
skinparam padding 6
skinparam wrapWidth 150
skinparam nodesep 12
skinparam ranksep 24
skinparam linetype ortho

' Node Styles
skinparam rectangle {
    BackgroundColor #FFFFFF
    BorderColor #000000
    BorderThickness 1.5
    FontColor #000000
}

skinparam rectangle<<critical>> {
    BackgroundColor #FFFFFF
    BorderColor #B91C1C
    BorderThickness 2.5
    FontColor #000000
}

skinparam rectangle<<milestone>> {
    BackgroundColor #FFFFFF
    BorderColor #B91C1C
    BorderThickness 2.5
    BorderStyle dashed
    FontColor #000000
}

skinparam rectangle<<noncritical>> {
    BackgroundColor #FFFFFF
    BorderColor #4B5563
    BorderThickness 1.2
    FontColor #000000
}

skinparam arrow {
    Color #B91C1C
    Thickness 2
    FontColor #000000
}

skinparam arrow<<noncrit_arrow>> {
    Color #4B5563
    Thickness 1.2
    FontColor #000000
}

